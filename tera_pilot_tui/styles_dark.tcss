/* styles_dark.tcss - Tera Pilot TUI dark theme
   v2.3.1: Minimalism — near-black surfaces, hairline
   borders, one warm accent (#d77757) used sparingly, smooth CSS
   transitions and entrance animations. */

/* ── Global ─────────────────────────────────────────────────────── */
Screen {
    background: #0a0a0c;
    color: #f5f5f7;
}

/* ── Info Box (v2.4.1 header) ──────────────────────────────────── */
InfoBox {
    dock: top;
    height: auto;
    margin: 1 2 0 2;
    padding: 0 1;
    border-bottom: solid #1f1f23;
    background: #0a0a0c;
}

/* ── Chat Log ───────────────────────────────────────────────────── */
ChatLog {
    height: 1fr;
    background: #0a0a0c;
    padding: 1 2;
    scrollbar-size: 1 1;
}

ChatLog:focus {
    scrollbar-color: #d77757;
}

/* ── Input Box (hairline border) ─────────────────── */
InputBox {
    dock: bottom;
    height: 3;
    border: solid #2e2e33;
    margin: 0 2 1 2;
    background: #131316;
}

InputBox:focus {
    border: solid #4a4a52;
    background: #141418;
}

InputBox:focus-within {
    border: solid #4a4a52;
}

/* Working state — the agent is running; a single warm accent line. */
InputBox.working {
    border: solid #d77757;
}

/* v2.4.1: gentle “breathing” pulse on the working input border. */
InputBox.working.pulse {
    border: solid #e8916b;
    background: #17171b;
}

/* ── Command Suggestions (inline, above input) ──────────────────── */
CommandSuggestions {
    dock: bottom;
    height: 0;
    margin: 0 2 0 2;
    display: none;
}

CommandSuggestions.visible {
    display: block;
    height: auto;
}

#suggestions-box {
    height: auto;
    max-height: 12;
    background: #111114;
    border: solid #2e2e33;
    padding: 0 1;
}

#suggestions-box OptionList {
    height: auto;
    max-height: 10;
}

#suggestions-footer {
    height: 1;
    color: #86868b;
    padding: 0 1;
    text-style: italic;
}

/* ── Approval Modal ─────────────────────────────────────────────── */
ApprovalModal {
    align: center middle;
}

#approval-box {
    width: 70%;
    max-width: 100;
    height: auto;
    padding: 1 2;
    border: round #8a6d1d;
    background: #131316;
}

#approval-title {
    text-style: bold;
    color: #d9a21b;
    margin-bottom: 1;
}

#approval-action {
    color: #f5f5f7;
    background: #0e0e11;
    border: solid #2e2e33;
    padding: 0 1;
    margin-bottom: 1;
    text-style: bold;
}

#approval-summary {
    color: #86868b;
    margin-bottom: 1;
}

#approval-buttons {
    height: auto;
    layout: horizontal;
    align: center middle;
    margin-top: 1;
}

#approval-buttons Button {
    width: 24;
    margin: 0 1;
    padding: 0 2;
}

#approval-buttons #approve {
    background: #1e7a34;
    color: #ffffff;
    text-style: bold;
    border: solid #2c9c46;
}

#approval-buttons #approve:hover {
    background: #2c9c46;
    text-style: bold;
}

#approval-buttons #approve:focus {
    background: #2c9c46;
    text-style: bold;
}

#approval-buttons #deny {
    background: #8f2d24;
    color: #ffffff;
    text-style: bold;
    border: solid #b03a2f;
}

#approval-buttons #deny:hover {
    background: #b03a2f;
    text-style: bold;
}

#approval-buttons #deny:focus {
    background: #b03a2f;
    text-style: bold;
}

/* ── Guardian Modal ─────────────────────────────────────────────── */
GuardianModal {
    align: center middle;
}

#guardian-box {
    width: 76%;
    max-width: 110;
    height: auto;
    padding: 1 2;
    border: round #7c3aed;
    background: #131316;
}

#guardian-title {
    text-style: bold;
    color: #a78bfa;
    margin-bottom: 1;
}

#guardian-action {
    color: #f5f5f7;
    background: #0e0e11;
    border: solid #2e2e33;
    padding: 0 1;
    margin-bottom: 1;
    text-style: bold;
}

#guardian-summary {
    color: #86868b;
    margin-bottom: 1;
}

#guardian-rationale {
    color: #d9a21b;
    margin-bottom: 1;
}

#guardian-fix-label {
    color: #86efac;
    margin-bottom: 0;
}

#guardian-fix-text {
    height: auto;
    max-height: 10;
    margin-bottom: 1;
    border: solid #2e2e33;
    background: #0e0e10;
}

#guardian-buttons {
    height: auto;
    layout: horizontal;
    align: center middle;
    margin-top: 1;
}

#guardian-buttons Button {
    width: 24;
    margin: 0 1;
    padding: 0 2;
}

#guardian-buttons #approve {
    background: #1e7a34;
    color: #ffffff;
    text-style: bold;
    border: solid #2c9c46;
}

#guardian-buttons #approve:hover {
    background: #2c9c46;
    text-style: bold;
}

#guardian-buttons #approve:focus {
    background: #2c9c46;
    text-style: bold;
}

#guardian-buttons #use_fix {
    background: #3d5a99;
    color: #ffffff;
    text-style: bold;
    border: solid #4f6fb8;
}

#guardian-buttons #use_fix:hover {
    background: #4f6fb8;
    text-style: bold;
}

#guardian-buttons #use_fix:focus {
    background: #4f6fb8;
    text-style: bold;
}

#guardian-buttons #reject {
    background: #8f2d24;
    color: #ffffff;
    text-style: bold;
    border: solid #b03a2f;
}

#guardian-buttons #reject:hover {
    background: #b03a2f;
    text-style: bold;
}

#guardian-buttons #reject:focus {
    background: #b03a2f;
    text-style: bold;
}

/* ── Verification Modal (G4) ────────────────────────────────────── */
VerificationModal {
    align: center middle;
}

#verify-box {
    width: 80%;
    max-width: 120;
    height: auto;
    max-height: 32;
    padding: 1 2;
    border: solid #6d7cf5;
    background: #131316;
}

#verify-title {
    text-style: bold;
    margin-bottom: 1;
}

#verify-grid {
    height: auto;
    margin-bottom: 1;
}

.verify-cell {
    width: 1fr;
    padding: 0 1;
}

#verify-meta {
    color: #86868b;
    margin-bottom: 1;
}

#verify-summary {
    color: #f5f5f7;
    margin-bottom: 1;
}

#verify-issues {
    color: #d9a21b;
    margin-bottom: 1;
}

#verify-suggestions {
    color: #6d7cf5;
    margin-bottom: 1;
}

#verify-raw {
    color: #86868b;
    margin-bottom: 1;
}

#verify-buttons {
    height: auto;
    align: center middle;
    margin-top: 1;
}

#verify-buttons Button {
    margin: 1 1 0 1;
    width: 100%;
}

/* ── Command Palette ────────────────────────────────────────────── */
CommandPalette {
    align: center bottom;
}

#palette-container {
    width: 70%;
    max-width: 80;
    height: auto;
    max-height: 22;
    background: #111114;
    border: solid #2e2e33;
    padding: 0;
    margin-bottom: 4;
}

#palette-header {
    background: #d77757 20%;
    color: #f5f5f7;
    padding: 0 1;
    height: 1;
    text-style: bold;
}

#palette-filter {
    height: 3;
    border: solid #2e2e33;
    margin: 0 1;
    padding: 0;
}

#palette-list {
    height: auto;
    max-height: 16;
    margin: 0 1;
}

#palette-list OptionList {
    height: auto;
    max-height: 16;
}

#palette-footer {
    height: 1;
    color: #86868b;
    padding: 0 1;
    text-style: italic;
}

/* ── Tool Block Widget ──────────────────────────────────────────── */
ToolBlock {
    height: auto;
    margin: 0 2;
    padding: 0 1;
    border: solid #3a2d44;
    background: #0e0e10;
}

ToolBlock .tool-header {
    color: #e879f9;
    text-style: bold;
}

ToolBlock .tool-content {
    color: #f5f5f7;
}

/* ── Thinking Indicator ─────────────────────────────────────────── */
ThinkingIndicator {
    height: 1;
    color: #d77757;
    padding: 0 2;
    text-style: bold;
}

/* ── Task Canvas View (G19a) ───────────────────────────────────── */
TaskCanvasView {
    dock: bottom;
    height: auto;
    max-height: 8;
    margin: 0 2 0 2;
    padding: 0 1;
    background: #0a0a0c;
    border-top: solid #1f1f23;
    color: #86868b;
}

/* ── Separator ──────────────────────────────────────────────────── */
.separator {
    color: #26262b;
}

/* ── Diff colors ────────────────────────────────────────────────── */
.diff-added {
    background: #1c3b26;
}

.diff-removed {
    background: #4a2430;
}

/* ── Auto-accept mode ───────────────────────────────────────────── */
.auto-accept {
    color: #af87ff;
}
