/* styles_dark.tcss - Tera Pilot TUI dark theme
   v2.3.1: Minimalism — near-black surfaces, hairline
   borders, one warm accent (#d77757) used sparingly, smooth CSS
   transitions and entrance animations. */

/* ── Global ─────────────────────────────────────────────────────── */
Screen {
    background: #0a0a0c;
    color: #f5f5f7;
}

/* ── Info Box (v2.4.1 header) ──────────────────────────────────── */
InfoBox {
    dock: top;
    height: auto;
    margin: 1 2 0 2;
    padding: 0 1;
    border-bottom: solid #1f1f23;
    background: #0a0a0c;
}

/* ── Chat Log ───────────────────────────────────────────────────── */
ChatLog {
    height: 1fr;
    background: #0a0a0c;
    padding: 1 2;
    scrollbar-size: 1 1;
}

ChatLog:focus {
    scrollbar-color: #d77757;
}

/* ── Input Box (hairline border) ─────────────────── */
/* v2.4.3: auto-growing composer. `margin` keeps it clear of the docked
   StatusBar — Textual's bottom-dock layout eats one margin row, and at
   1 the statusline's top border landed ON the input's bottom border.
   4 leaves a blank spacer row on top of that eaten row, so the composer
   and the statusline never touch. */
InputBox {
    dock: bottom;
    /* width: 100% (not 1fr) — fr resolves against the raw screen width and
       ignores the horizontal margins, which pushed the box off-screen. */
    width: 100%;
    height: auto;
    max-height: 10;
    min-height: 3;
    border: solid #2e2e33;
    margin: 0 2 4 2;
    padding: 0 1;
    background: #131316;
    scrollbar-size-vertical: 1;
    scrollbar-color: #3a3a41;
}

InputBox:focus {
    border: solid #4a4a52;
    background: #141418;
}

InputBox:focus-within {
    border: solid #4a4a52;
}

/* Working state — the agent is running; a single warm accent line. */
InputBox.working {
    border: solid #d77757;
}

/* v2.4.1: gentle “breathing” pulse on the working input border. */
InputBox.working.pulse {
    border: solid #e8916b;
    background: #17171b;
}

/* ── Command Suggestions (inline, above input) ──────────────────── */
CommandSuggestions {
    dock: bottom;
    height: 0;
    margin: 0 2 0 2;
    display: none;
}

CommandSuggestions.visible {
    display: block;
    height: auto;
}

#suggestions-box {
    height: auto;
    max-height: 12;
    background: #111114;
    border: solid #2e2e33;
    padding: 0 1;
}

#suggestions-box OptionList {
    height: auto;
    max-height: 10;
}

#suggestions-footer {
    height: 1;
    color: #86868b;
    padding: 0 1;
    text-style: italic;
}

/* ── Approval Modal ─────────────────────────────────────────────── */
ApprovalModal {
    align: center middle;
}

#approval-box {
    width: 70%;
    max-width: 100;
    height: auto;
    padding: 1 2;
    border: round #8a6d1d;
    background: #131316;
}

#approval-title {
    text-style: bold;
    color: #d9a21b;
    margin-bottom: 1;
}

#approval-action {
    color: #f5f5f7;
    background: #0e0e11;
    border: solid #2e2e33;
    padding: 0 1;
    margin-bottom: 1;
    text-style: bold;
}

#approval-summary {
    color: #86868b;
    margin-bottom: 1;
}

#approval-buttons {
    height: auto;
    layout: horizontal;
    align: center middle;
    margin-top: 1;
}

/* v2.4.3: rounded accent buttons. The old rules painted 24-wide solid
   slabs (Textual's tall top/bottom borders) — filled rectangles that
   clashed with the modal's round hairline border. Now: round border,
   tinted surface and accent label at rest, a deeper fill once focused,
   so the armed choice is unmistakable. */
#approval-buttons Button,
#guardian-buttons Button {
    width: auto;
    min-width: 16;
    height: 3;
    margin: 0 1;
    padding: 0 2;
    border: round #33333a;
    background: #131316;
    color: #d4d4d8;
    text-style: bold;
}

#approval-buttons #approve {
    border: round #2f7d4f;
    background: #101f18;
    color: #86dfa9;
}

#approval-buttons #approve:hover {
    border: round #3d9c62;
    background: #14291e;
    color: #a8ecc3;
}

#approval-buttons #approve:focus {
    border: round #4cc17c;
    background: #17402a;
    color: #f2fff7;
}

#approval-buttons #deny {
    border: round #8f3a33;
    background: #1e1214;
    color: #ef9a90;
}

#approval-buttons #deny:hover {
    border: round #b0463b;
    background: #2a1719;
    color: #ffbdb5;
}

#approval-buttons #deny:focus {
    border: round #e0604f;
    background: #3d1c1b;
    color: #fff1ef;
}

/* ── Guardian Modal ─────────────────────────────────────────────── */
GuardianModal {
    align: center middle;
}

#guardian-box {
    width: 76%;
    max-width: 110;
    height: auto;
    padding: 1 2;
    border: round #7c3aed;
    background: #131316;
}

#guardian-title {
    text-style: bold;
    color: #a78bfa;
    margin-bottom: 1;
}

#guardian-action {
    color: #f5f5f7;
    background: #0e0e11;
    border: solid #2e2e33;
    padding: 0 1;
    margin-bottom: 1;
    text-style: bold;
}

#guardian-summary {
    color: #86868b;
    margin-bottom: 1;
}

#guardian-rationale {
    color: #d9a21b;
    margin-bottom: 1;
}

#guardian-fix-label {
    color: #86efac;
    margin-bottom: 0;
}

#guardian-fix-text {
    height: auto;
    max-height: 10;
    margin-bottom: 1;
    border: solid #2e2e33;
    background: #0e0e10;
}

#guardian-buttons {
    height: auto;
    layout: horizontal;
    align: center middle;
    margin-top: 1;
}

#guardian-buttons #approve {
    border: round #2f7d4f;
    background: #101f18;
    color: #86dfa9;
}

#guardian-buttons #approve:hover {
    border: round #3d9c62;
    background: #14291e;
    color: #a8ecc3;
}

#guardian-buttons #approve:focus {
    border: round #4cc17c;
    background: #17402a;
    color: #f2fff7;
}

#guardian-buttons #use_fix {
    border: round #4f5fb8;
    background: #131424;
    color: #a8b4fb;
}

#guardian-buttons #use_fix:hover {
    border: round #6673d6;
    background: #191b30;
    color: #c6cdff;
}

#guardian-buttons #use_fix:focus {
    border: round #7f8cf5;
    background: #20244a;
    color: #ffffff;
}

#guardian-buttons #reject {
    border: round #8f3a33;
    background: #1e1214;
    color: #ef9a90;
}

#guardian-buttons #reject:hover {
    border: round #b0463b;
    background: #2a1719;
    color: #ffbdb5;
}

#guardian-buttons #reject:focus {
    border: round #e0604f;
    background: #3d1c1b;
    color: #fff1ef;
}

/* ── Verification Modal (G4) ────────────────────────────────────── */
VerificationModal {
    align: center middle;
}

#verify-box {
    width: 80%;
    max-width: 120;
    height: auto;
    max-height: 32;
    padding: 1 2;
    border: solid #6d7cf5;
    background: #131316;
}

#verify-title {
    text-style: bold;
    margin-bottom: 1;
}

#verify-grid {
    height: auto;
    margin-bottom: 1;
}

.verify-cell {
    width: 1fr;
    padding: 0 1;
}

#verify-meta {
    color: #86868b;
    margin-bottom: 1;
}

#verify-summary {
    color: #f5f5f7;
    margin-bottom: 1;
}

#verify-issues {
    color: #d9a21b;
    margin-bottom: 1;
}

#verify-suggestions {
    color: #6d7cf5;
    margin-bottom: 1;
}

#verify-raw {
    color: #86868b;
    margin-bottom: 1;
}

#verify-buttons {
    height: auto;
    align: center middle;
    margin-top: 1;
}

#verify-buttons Button {
    margin: 1 1 0 1;
    width: 100%;
}

/* ── Command Palette ────────────────────────────────────────────── */
CommandPalette {
    align: center bottom;
}

#palette-container {
    width: 70%;
    max-width: 80;
    height: auto;
    max-height: 22;
    background: #111114;
    border: solid #2e2e33;
    padding: 0;
    margin-bottom: 4;
}

#palette-header {
    background: #d77757 20%;
    color: #f5f5f7;
    padding: 0 1;
    height: 1;
    text-style: bold;
}

#palette-filter {
    height: 3;
    border: solid #2e2e33;
    margin: 0 1;
    padding: 0;
}

#palette-list {
    height: auto;
    max-height: 16;
    margin: 0 1;
}

#palette-list OptionList {
    height: auto;
    max-height: 16;
}

#palette-footer {
    height: 1;
    color: #86868b;
    padding: 0 1;
    text-style: italic;
}

/* ── Tool Block Widget ──────────────────────────────────────────── */
ToolBlock {
    height: auto;
    margin: 0 2;
    padding: 0 1;
    border: solid #3a2d44;
    background: #0e0e10;
}

ToolBlock .tool-header {
    color: #e879f9;
    text-style: bold;
}

ToolBlock .tool-content {
    color: #f5f5f7;
}

/* ── Thinking Indicator ─────────────────────────────────────────── */
ThinkingIndicator {
    height: 1;
    color: #d77757;
    padding: 0 2;
    text-style: bold;
}

/* ── Task Canvas View (G19a) ───────────────────────────────────── */
TaskCanvasView {
    dock: bottom;
    height: auto;
    max-height: 8;
    margin: 0 2 0 2;
    padding: 0 1;
    background: #0a0a0c;
    border-top: solid #1f1f23;
    color: #86868b;
}

/* ── Separator ──────────────────────────────────────────────────── */
.separator {
    color: #26262b;
}

/* ── Diff colors ────────────────────────────────────────────────── */
.diff-added {
    background: #1c3b26;
}

.diff-removed {
    background: #4a2430;
}

/* ── Auto-accept mode ───────────────────────────────────────────── */
.auto-accept {
    color: #af87ff;
}

/* ── Thinking strip (v2.4.2) ──────────────────────────────────── */
/* Ephemeral one-line indicator between chat and input. Hidden unless
   the .visible class is set while a turn runs. */
#thinking {
    height: 1;
    margin: 0 2;
    padding: 0 1;
    display: none;
    color: #d77757;
}

#thinking.visible {
    display: block;
}

/* ── StatusBar statusline (v2.4.2) ────────────────────────────── */
/* Bottom two-line statusline: state + provider/model + tokens/cost,
   hints row. Docked at the very bottom edge, below the input box. */
/* v2.4.3: bottom margin lifts the statusline off the very last row —
   Textual's bottom-dock layout consumes one margin row, so 1 is enough
   to leave a visible gap under the bar. */
StatusBar {
    dock: bottom;
    height: 2;
    margin: 0 2 1 2;
    padding: 0 1;
    border-top: solid #1f1f23;
    background: #0a0a0c;
    color: #f5f5f7;
}

/* ── Task canvas strip (v2.4.2) ───────────────────────────────── */
/* Live task-graph (plan → subtasks). Hidden unless the .visible class
   is set while the canvas holds nodes. Capped so a big graph never
   eats the chat area. */
#canvas {
    height: auto;
    max-height: 8;
    margin: 0 2;
    padding: 0 1;
    display: none;
    overflow-y: auto;
    color: #d77757;
}

#canvas.visible {
    display: block;
}
