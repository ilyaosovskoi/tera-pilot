/* styles_light.tcss - Tera Pilot TUI light theme
   v2.3.1: Minimalism — clean white surfaces, hairline
   borders, one warm accent (#d77757) used sparingly, smooth CSS
   transitions and entrance animations. */

/* ── Global ─────────────────────────────────────────────────────── */
Screen {
    background: #fafafa;
    color: #1a1a1e;
}

/* ── Status Bar ─────────────────────────────────────────────────── */
StatusBar {
    dock: top;
    height: 3;
    background: #fafafa;
    color: #6e6e76;
    border-bottom: solid #e4e4e7;
}

/* ── Chat Log ───────────────────────────────────────────────────── */
ChatLog {
    height: 1fr;
    background: #fafafa;
    padding: 1 2;
    scrollbar-size: 1 1;
}

ChatLog:focus {
    scrollbar-color: #d77757;
}

/* ── Input Box (hairline border) ─────────────────── */
InputBox {
    dock: bottom;
    height: 3;
    border: solid #d4d4d8;
    margin: 0 2 1 2;
    background: #ffffff;
}

InputBox:focus {
    border: solid #a1a1aa;
    background: #ffffff;
}

InputBox:focus-within {
    border: solid #a1a1aa;
}

/* Working state — the agent is running; a single warm accent line. */
InputBox.working {
    border: solid #d77757;
}

/* ── Command Suggestions (inline, above input) ──────────────────── */
CommandSuggestions {
    dock: bottom;
    height: 0;
    margin: 0 2 0 2;
    display: none;
}

CommandSuggestions.visible {
    display: block;
    height: auto;
}

#suggestions-box {
    height: auto;
    max-height: 12;
    background: #ffffff;
    border: solid #d4d4d8;
    padding: 0 1;
}

#suggestions-box OptionList {
    height: auto;
    max-height: 10;
}

#suggestions-footer {
    height: 1;
    color: #6e6e76;
    padding: 0 1;
    text-style: italic;
}

/* ── Approval Modal ─────────────────────────────────────────────── */
ApprovalModal {
    align: center middle;
}

#approval-box {
    width: 70%;
    max-width: 100;
    height: auto;
    padding: 1 2;
    border: round #d9a21b;
    background: #ffffff;
}

#approval-title {
    text-style: bold;
    color: #9a6a00;
    margin-bottom: 1;
}

#approval-action {
    color: #1a1a1e;
    background: #f6f6f7;
    border: solid #d4d4d8;
    padding: 0 1;
    margin-bottom: 1;
    text-style: bold;
}

#approval-summary {
    color: #6e6e76;
    margin-bottom: 1;
}

#approval-buttons {
    height: auto;
    layout: horizontal;
    align: center middle;
    margin-top: 1;
}

#approval-buttons Button {
    width: 24;
    margin: 0 1;
    padding: 0 2;
}

#approval-buttons #approve {
    background: #1e7a34;
    color: #ffffff;
    text-style: bold;
    border: solid #2c9c46;
}

#approval-buttons #approve:hover {
    background: #2c9c46;
    text-style: bold;
}

#approval-buttons #approve:focus {
    background: #2c9c46;
    text-style: bold;
}

#approval-buttons #deny {
    background: #8f2d24;
    color: #ffffff;
    text-style: bold;
    border: solid #b03a2f;
}

#approval-buttons #deny:hover {
    background: #b03a2f;
    text-style: bold;
}

#approval-buttons #deny:focus {
    background: #b03a2f;
    text-style: bold;
}

/* ── Guardian Modal ─────────────────────────────────────────────── */
GuardianModal {
    align: center middle;
}

#guardian-box {
    width: 76%;
    max-width: 110;
    height: auto;
    padding: 1 2;
    border: round #7c3aed;
    background: #ffffff;
}

#guardian-title {
    text-style: bold;
    color: #6d28d9;
    margin-bottom: 1;
}

#guardian-action {
    color: #1a1a1e;
    background: #f6f6f7;
    border: solid #d4d4d8;
    padding: 0 1;
    margin-bottom: 1;
    text-style: bold;
}

#guardian-summary {
    color: #6e6e76;
    margin-bottom: 1;
}

#guardian-rationale {
    color: #9a6a00;
    margin-bottom: 1;
}

#guardian-fix-label {
    color: #15803d;
    margin-bottom: 0;
}

#guardian-fix-text {
    height: auto;
    max-height: 10;
    margin-bottom: 1;
    border: solid #d4d4d8;
    background: #f6f6f7;
}

#guardian-buttons {
    height: auto;
    layout: horizontal;
    align: center middle;
    margin-top: 1;
}

#guardian-buttons Button {
    width: 24;
    margin: 0 1;
    padding: 0 2;
}

#guardian-buttons #approve {
    background: #1e7a34;
    color: #ffffff;
    text-style: bold;
    border: solid #2c9c46;
}

#guardian-buttons #approve:hover {
    background: #2c9c46;
    text-style: bold;
}

#guardian-buttons #approve:focus {
    background: #2c9c46;
    text-style: bold;
}

#guardian-buttons #use_fix {
    background: #3d5a99;
    color: #ffffff;
    text-style: bold;
    border: solid #4f6fb8;
}

#guardian-buttons #use_fix:hover {
    background: #4f6fb8;
    text-style: bold;
}

#guardian-buttons #use_fix:focus {
    background: #4f6fb8;
    text-style: bold;
}

#guardian-buttons #reject {
    background: #8f2d24;
    color: #ffffff;
    text-style: bold;
    border: solid #b03a2f;
}

#guardian-buttons #reject:hover {
    background: #b03a2f;
    text-style: bold;
}

#guardian-buttons #reject:focus {
    background: #b03a2f;
    text-style: bold;
}

/* ── Verification Modal (G4) ────────────────────────────────────── */
VerificationModal {
    align: center middle;
}

#verify-box {
    width: 80%;
    max-width: 120;
    height: auto;
    max-height: 32;
    padding: 1 2;
    border: solid #6d7cf5;
    background: #ffffff;
}

#verify-title {
    text-style: bold;
    margin-bottom: 1;
}

#verify-grid {
    height: auto;
    margin-bottom: 1;
}

.verify-cell {
    width: 1fr;
    padding: 0 1;
}

#verify-meta {
    color: #6e6e76;
    margin-bottom: 1;
}

#verify-summary {
    color: #1a1a1e;
    margin-bottom: 1;
}

#verify-issues {
    color: #9a6a00;
    margin-bottom: 1;
}

#verify-suggestions {
    color: #4f46e5;
    margin-bottom: 1;
}

#verify-raw {
    color: #6e6e76;
    margin-bottom: 1;
}

#verify-buttons {
    height: auto;
    align: center middle;
    margin-top: 1;
}

#verify-buttons Button {
    margin: 1 1 0 1;
    width: 100%;
}

/* ── Command Palette ────────────────────────────────────────────── */
CommandPalette {
    align: center bottom;
}

#palette-container {
    width: 70%;
    max-width: 80;
    height: auto;
    max-height: 22;
    background: #ffffff;
    border: solid #d4d4d8;
    padding: 0;
    margin-bottom: 4;
}

#palette-header {
    background: #d77757 20%;
    color: #1a1a1e;
    padding: 0 1;
    height: 1;
    text-style: bold;
}

#palette-filter {
    height: 3;
    border: solid #d4d4d8;
    margin: 0 1;
    padding: 0;
}

#palette-list {
    height: auto;
    max-height: 16;
    margin: 0 1;
}

#palette-list OptionList {
    height: auto;
    max-height: 16;
}

#palette-footer {
    height: 1;
    color: #6e6e76;
    padding: 0 1;
    text-style: italic;
}

/* ── Tool Block Widget ──────────────────────────────────────────── */
ToolBlock {
    height: auto;
    margin: 0 2;
    padding: 0 1;
    border: solid #e8d5e2;
    background: #ffffff;
}

ToolBlock .tool-header {
    color: #c026d3;
    text-style: bold;
}

ToolBlock .tool-content {
    color: #1a1a1e;
}

/* ── Thinking Indicator ─────────────────────────────────────────── */
ThinkingIndicator {
    height: 1;
    color: #d77757;
    padding: 0 2;
    text-style: bold;
}

/* ── Task Canvas View (G19a) ───────────────────────────────────── */
TaskCanvasView {
    dock: bottom;
    height: auto;
    max-height: 8;
    margin: 0 2 0 2;
    padding: 0 1;
    background: #fafafa;
    border-top: solid #e4e4e7;
    color: #6e6e76;
}

/* ── Separator ──────────────────────────────────────────────────── */
.separator {
    color: #e4e4e7;
}

/* ── Diff colors ────────────────────────────────────────────────── */
.diff-added {
    background: #dcfce7;
}

.diff-removed {
    background: #fee2e2;
}

/* ── Auto-accept mode ───────────────────────────────────────────── */
.auto-accept {
    color: #6d28d9;
}
