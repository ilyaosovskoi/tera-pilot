/* styles_light.tcss - Tera Pilot TUI light theme
   v2.3.1: Minimalism — clean white surfaces, hairline
   borders, one warm accent (#d77757) used sparingly, smooth CSS
   transitions and entrance animations. */

/* ── Global ─────────────────────────────────────────────────────── */
Screen {
    background: #fafafa;
    color: #1a1a1e;
}

/* ── Info Box (v2.4.1 header) ──────────────────────────────────── */
InfoBox {
    dock: top;
    height: auto;
    margin: 1 2 0 2;
    padding: 0 1;
    border-bottom: solid #e4e4e7;
    background: #fafafa;
}

/* ── Chat Log ───────────────────────────────────────────────────── */
ChatLog {
    height: 1fr;
    background: #fafafa;
    padding: 1 2;
    scrollbar-size: 1 1;
}

ChatLog:focus {
    scrollbar-color: #d77757;
}

/* ── Input Box (hairline border) ─────────────────── */
/* v2.4.3: auto-growing composer. `margin` keeps it clear of the docked
   StatusBar — Textual's bottom-dock layout eats one margin row, and at
   1 the statusline's top border landed ON the input's bottom border.
   4 leaves a blank spacer row on top of that eaten row, so the composer
   and the statusline never touch. */
InputBox {
    dock: bottom;
    /* width: 100% (not 1fr) — fr resolves against the raw screen width and
       ignores the horizontal margins, which pushed the box off-screen. */
    width: 100%;
    height: auto;
    max-height: 10;
    min-height: 3;
    border: solid #d4d4d8;
    margin: 0 2 4 2;
    padding: 0 1;
    background: #ffffff;
    scrollbar-size-vertical: 1;
    scrollbar-color: #c4c4cc;
}

InputBox:focus {
    border: solid #a1a1aa;
    background: #ffffff;
}

InputBox:focus-within {
    border: solid #a1a1aa;
}

/* Working state — the agent is running; a single warm accent line. */
InputBox.working {
    border: solid #c75b33;
}

/* v2.4.1: gentle “breathing” pulse on the working input border. */
InputBox.working.pulse {
    border: solid #e2794d;
    background: #fff7f4;
}

/* ── Command Suggestions (inline, above input) ──────────────────── */
CommandSuggestions {
    dock: bottom;
    height: 0;
    margin: 0 2 0 2;
    display: none;
}

CommandSuggestions.visible {
    display: block;
    height: auto;
}

#suggestions-box {
    height: auto;
    max-height: 12;
    background: #ffffff;
    border: solid #d4d4d8;
    padding: 0 1;
}

#suggestions-box OptionList {
    height: auto;
    max-height: 10;
}

#suggestions-footer {
    height: 1;
    color: #6e6e76;
    padding: 0 1;
    text-style: italic;
}

/* ── Approval Modal ─────────────────────────────────────────────── */
ApprovalModal {
    align: center middle;
}

#approval-box {
    width: 70%;
    max-width: 100;
    height: auto;
    padding: 1 2;
    border: round #d9a21b;
    background: #ffffff;
}

#approval-title {
    text-style: bold;
    color: #9a6a00;
    margin-bottom: 1;
}

#approval-action {
    color: #1a1a1e;
    background: #f6f6f7;
    border: solid #d4d4d8;
    padding: 0 1;
    margin-bottom: 1;
    text-style: bold;
}

#approval-summary {
    color: #6e6e76;
    margin-bottom: 1;
}

#approval-buttons {
    height: auto;
    layout: horizontal;
    align: center middle;
    margin-top: 1;
}

/* v2.4.3: rounded accent buttons. The old rules painted 24-wide solid
   slabs (Textual's tall top/bottom borders) — filled rectangles that
   clashed with the modal's round hairline border. Now: round border,
   tinted surface and accent label at rest, a deeper fill once focused,
   so the armed choice is unmistakable. */
#approval-buttons Button,
#guardian-buttons Button {
    width: auto;
    min-width: 16;
    height: 3;
    margin: 0 1;
    padding: 0 2;
    border: round #c9c9d1;
    background: #ffffff;
    color: #3f3f46;
    text-style: bold;
}

#approval-buttons #approve {
    border: round #2f8a54;
    background: #f1faf4;
    color: #1e6b40;
}

#approval-buttons #approve:hover {
    border: round #35a061;
    background: #e2f4ea;
    color: #175433;
}

#approval-buttons #approve:focus {
    border: round #1f8a4c;
    background: #d0ebdb;
    color: #0d3d24;
}

#approval-buttons #deny {
    border: round #c0564a;
    background: #fdf5f4;
    color: #9c3227;
}

#approval-buttons #deny:hover {
    border: round #d0665a;
    background: #f9e5e2;
    color: #86291f;
}

#approval-buttons #deny:focus {
    border: round #c0392b;
    background: #f4d5d0;
    color: #6d1f17;
}

/* ── Guardian Modal ─────────────────────────────────────────────── */
GuardianModal {
    align: center middle;
}

#guardian-box {
    width: 76%;
    max-width: 110;
    height: auto;
    padding: 1 2;
    border: round #7c3aed;
    background: #ffffff;
}

#guardian-title {
    text-style: bold;
    color: #6d28d9;
    margin-bottom: 1;
}

#guardian-action {
    color: #1a1a1e;
    background: #f6f6f7;
    border: solid #d4d4d8;
    padding: 0 1;
    margin-bottom: 1;
    text-style: bold;
}

#guardian-summary {
    color: #6e6e76;
    margin-bottom: 1;
}

#guardian-rationale {
    color: #9a6a00;
    margin-bottom: 1;
}

#guardian-fix-label {
    color: #15803d;
    margin-bottom: 0;
}

#guardian-fix-text {
    height: auto;
    max-height: 10;
    margin-bottom: 1;
    border: solid #d4d4d8;
    background: #f6f6f7;
}

#guardian-buttons {
    height: auto;
    layout: horizontal;
    align: center middle;
    margin-top: 1;
}

#guardian-buttons #approve {
    border: round #2f8a54;
    background: #f1faf4;
    color: #1e6b40;
}

#guardian-buttons #approve:hover {
    border: round #35a061;
    background: #e2f4ea;
    color: #175433;
}

#guardian-buttons #approve:focus {
    border: round #1f8a4c;
    background: #d0ebdb;
    color: #0d3d24;
}

#guardian-buttons #use_fix {
    border: round #4f5fb8;
    background: #f4f5fd;
    color: #3a4bb8;
}

#guardian-buttons #use_fix:hover {
    border: round #6673d6;
    background: #e8eafb;
    color: #2f3d99;
}

#guardian-buttons #use_fix:focus {
    border: round #3a4bb8;
    background: #dcdef9;
    color: #232e78;
}

#guardian-buttons #reject {
    border: round #c0564a;
    background: #fdf5f4;
    color: #9c3227;
}

#guardian-buttons #reject:hover {
    border: round #d0665a;
    background: #f9e5e2;
    color: #86291f;
}

#guardian-buttons #reject:focus {
    border: round #c0392b;
    background: #f4d5d0;
    color: #6d1f17;
}

/* ── Verification Modal (G4) ────────────────────────────────────── */
VerificationModal {
    align: center middle;
}

#verify-box {
    width: 80%;
    max-width: 120;
    height: auto;
    max-height: 32;
    padding: 1 2;
    border: solid #6d7cf5;
    background: #ffffff;
}

#verify-title {
    text-style: bold;
    margin-bottom: 1;
}

#verify-grid {
    height: auto;
    margin-bottom: 1;
}

.verify-cell {
    width: 1fr;
    padding: 0 1;
}

#verify-meta {
    color: #6e6e76;
    margin-bottom: 1;
}

#verify-summary {
    color: #1a1a1e;
    margin-bottom: 1;
}

#verify-issues {
    color: #9a6a00;
    margin-bottom: 1;
}

#verify-suggestions {
    color: #4f46e5;
    margin-bottom: 1;
}

#verify-raw {
    color: #6e6e76;
    margin-bottom: 1;
}

#verify-buttons {
    height: auto;
    align: center middle;
    margin-top: 1;
}

#verify-buttons Button {
    margin: 1 1 0 1;
    width: 100%;
}

/* ── Command Palette ────────────────────────────────────────────── */
CommandPalette {
    align: center bottom;
}

#palette-container {
    width: 70%;
    max-width: 80;
    height: auto;
    max-height: 22;
    background: #ffffff;
    border: solid #d4d4d8;
    padding: 0;
    margin-bottom: 4;
}

#palette-header {
    background: #d77757 20%;
    color: #1a1a1e;
    padding: 0 1;
    height: 1;
    text-style: bold;
}

#palette-filter {
    height: 3;
    border: solid #d4d4d8;
    margin: 0 1;
    padding: 0;
}

#palette-list {
    height: auto;
    max-height: 16;
    margin: 0 1;
}

#palette-list OptionList {
    height: auto;
    max-height: 16;
}

#palette-footer {
    height: 1;
    color: #6e6e76;
    padding: 0 1;
    text-style: italic;
}

/* ── Tool Block Widget ──────────────────────────────────────────── */
ToolBlock {
    height: auto;
    margin: 0 2;
    padding: 0 1;
    border: solid #e8d5e2;
    background: #ffffff;
}

ToolBlock .tool-header {
    color: #c026d3;
    text-style: bold;
}

ToolBlock .tool-content {
    color: #1a1a1e;
}

/* ── Thinking Indicator ─────────────────────────────────────────── */
ThinkingIndicator {
    height: 1;
    color: #d77757;
    padding: 0 2;
    text-style: bold;
}

/* ── Task Canvas View (G19a) ───────────────────────────────────── */
TaskCanvasView {
    dock: bottom;
    height: auto;
    max-height: 8;
    margin: 0 2 0 2;
    padding: 0 1;
    background: #fafafa;
    border-top: solid #e4e4e7;
    color: #6e6e76;
}

/* ── Separator ──────────────────────────────────────────────────── */
.separator {
    color: #e4e4e7;
}

/* ── Diff colors ────────────────────────────────────────────────── */
.diff-added {
    background: #dcfce7;
}

.diff-removed {
    background: #fee2e2;
}

/* ── Auto-accept mode ───────────────────────────────────────────── */
.auto-accept {
    color: #6d28d9;
}

/* ── Thinking strip (v2.4.2) ──────────────────────────────────── */
/* Ephemeral one-line indicator between chat and input. Hidden unless
   the .visible class is set while a turn runs. */
#thinking {
    height: 1;
    margin: 0 2;
    padding: 0 1;
    display: none;
    color: #b34d2e;
}

#thinking.visible {
    display: block;
}

/* ── StatusBar statusline (v2.4.2) ────────────────────────────── */
/* Bottom two-line statusline: state + provider/model + tokens/cost,
   hints row. Docked at the very bottom edge, below the input box. */
/* v2.4.3: bottom margin lifts the statusline off the very last row —
   Textual's bottom-dock layout consumes one margin row, so 1 is enough
   to leave a visible gap under the bar. */
StatusBar {
    dock: bottom;
    height: 2;
    margin: 0 2 1 2;
    padding: 0 1;
    border-top: solid #e4e4e7;
    background: #fafafa;
    color: #1a1a1e;
}

/* ── Task canvas strip (v2.4.2) ───────────────────────────────── */
/* Live task-graph (plan → subtasks). Hidden unless the .visible class
   is set while the canvas holds nodes. Capped so a big graph never
   eats the chat area. */
#canvas {
    height: auto;
    max-height: 8;
    margin: 0 2;
    padding: 0 1;
    display: none;
    overflow-y: auto;
    color: #b34d2e;
}

#canvas.visible {
    display: block;
}
